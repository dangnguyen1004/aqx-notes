{
  "expo": {
    "name": "AQX Notes",
    "slug": "aqx-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "aqxnotes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqx.notes",
      "associatedDomains": [
        "applinks:aqxnotes.app",
        "applinks:www.aqxnotes.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.aqx.notes",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aqxnotes.app",
              "pathPrefix": "/note"
            },
            {
              "scheme": "https",
              "host": "www.aqxnotes.app",
              "pathPrefix": "/note"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-localization"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8082d5c5-2b35-4b15-a805-11ca66675683"
      }
    },
    "owner": "nguyen_dang",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8082d5c5-2b35-4b15-a805-11ca66675683"
    }
  }
}
